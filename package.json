{
  "name": "mcp-server-anydoc",
  "mcpName": "io.github.ofershap/anydoc",
  "version": "1.0.0",
  "description": "Local MCP server that converts PDF, Word, PowerPoint, Excel and more to Markdown with anydoc. No API key. Files stay on your machine.",
  "type": "module",
  "bin": {
    "mcp-server-anydoc": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    ".mcp.json",
    ".claude-plugin",
    "server.json",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "anydoc",
    "markdown",
    "pdf",
    "docx",
    "pptx",
    "xlsx",
    "document-conversion",
    "office",
    "claude",
    "claude-code",
    "cursor",
    "privacy",
    "local"
  ],
  "author": "Ofer Shapira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ofershap/mcp-server-anydoc.git"
  },
  "bugs": {
    "url": "https://github.com/ofershap/mcp-server-anydoc/issues"
  },
  "homepage": "https://github.com/ofershap/mcp-server-anydoc#readme",
  "dependencies": {
    "@firecrawl/anydoc": "^0.1.7",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
